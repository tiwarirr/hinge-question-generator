generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("teacher")
  createdAt DateTime @default(now())

  questions Question[]
  sessions  QuizSession[]
  responses Response[]
}

model Question {
  id        String   @id @default(uuid())
  teacherId String
  teacher   User     @relation(fields: [teacherId], references: [id])
  topic     String
  subtopic  String?
  stem      String
  options   Option[]
  sessionId String?
  session   QuizSession? @relation(fields: [sessionId], references: [id])
  responses Response[]
  createdAt DateTime @default(now())
}

model Option {
  id             String   @id @default(uuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text           String
  isCorrect      Boolean
  misconception  String?
  responses      Response[]
}

model QuizSession {
  id        String     @id @default(uuid())
  teacherId String
  teacher   User       @relation(fields: [teacherId], references: [id])
  title     String
  topic     String
  code      String     @unique
  status    String     @default("active")
  questions Question[]
  responses Response[]
  createdAt DateTime   @default(now())
}

model Response {
  id              String      @id @default(uuid())
  sessionId       String
  session         QuizSession @relation(fields: [sessionId], references: [id])
  questionId      String
  question        Question    @relation(fields: [questionId], references: [id])
  studentId       String?
  student         User?       @relation(fields: [studentId], references: [id])
  studentName     String?
  selectedOptionId String
  selectedOption  Option      @relation(fields: [selectedOptionId], references: [id])
  entryMode       String      @default("in-app")
  createdAt       DateTime    @default(now())
}
